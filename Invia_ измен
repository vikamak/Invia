/* ---------- home feed ---------- */
function home(){if(S.vp)return vprof(pp(S.vp));const left=S.prem?'∞':3-S.sent;return (S.prem?'':`<div class="ad" onclick="paywall()"><span>Реклама · Grand Café: −10% для пар Invia</span><span>Убрать</span></div>`)+P.filter(p=>!S.u.look||p.s==S.u.look).map((p,i)=>{const k=S.ph[p.id]||0;return `<section class="feed" ${!S.prem&&i==0?'style="padding-top:58px"':''}>
