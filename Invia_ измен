function keep(){if($('#lt'))S.inv.tx=$('#lt').value;render()}
function tg(k){S.inv.tx=$('#lt')?$('#lt').value:S.inv.tx;S.open=S.open==k?null:k;render()}
function pickPlace(){S.inv.tx=$('#lt').value;go({scr:'app',tab:'place',pick:true,pd:null})}
function sendInv(){const v=S.inv;v.tx=$('#lt').value;if(!v.pl)return toast('Выбери место свидания');if(!v.d||!v.t)return toast('Выбери дату и время');if(!v.cond)return toast('Выбери условия');if(!v.tx.trim())return toast('Напиши короткое письмо');
S.sent++;S.ev.push({d:v.d,t:v.t,pl:plc(v.pl).n,p:v.p,st:'wait'});S.sd=v.d;S.inv=null;go({scr:'app',tab:'plan'});toast('Письмо отправлено. Ждём ответ')}
function calHTML(sel){const ds=S.ev.map(e=>e.d);return `<div class="cal">${['Вс','Пн','Вт','Ср','Чт','Пт','Сб'].map(d=>`<b>${d}</b>`).join('')}${'<span></span>'.repeat(2)}${Array.from({length:30},(_,i)=>i+1).map(d=>`<button class="${d==sel?'sel':''} ${d==16?'today':''}" ${d<16?'disabled':''} onclick="S.inv.d=${d};S.inv.t=S.inv.t||'19.00';keep()">${d}${ds.includes(d)?'<i></i>':''}</button>`).join('')}</div>`}
function calGrid(sel,onclick,id){const ds=S.ev.map(e=>e.d);return `<div class="cal" id="${id}">${['Вс','Пн','Вт','Ср','Чт','Пт','Сб'].map(d=>`<b>${d}</b>`).join('')}${'<span></span>'.repeat(2)}${Array.from({length:30},(_,i)=>i+1).map(d=>`<button type="button" data-d="${d}" class="${d==sel?'sel':''} ${d==16?'today':''}" onclick="${onclick}(${d})">${d}${ds.includes(d)?'<i></i>':''}</button>`).join('')}</div>`}
