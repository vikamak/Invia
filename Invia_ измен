<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div>${l('Знак зодиака')}<input class="in" id="e5" placeholder="Не указан" value="${esc(u.zodiac)}"></div><div>${l('Рост, см')}<input class="in" id="e6" type="number" placeholder="178" value="${esc(u.height)}"></div></div>
${l('Образование')}<input class="in" id="e7" placeholder="Например: Высшее" value="${esc(u.edu)}">
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div>${l('Алкоголь')}<input class="in" id="e8" placeholder="Иногда" value="${esc(u.alco)}"></div><div>${l('Курение')}<input class="in" id="e9" placeholder="Не курю" value="${esc(u.smoke)}"></div></div></div>
<button class="btn main" onclick="saveP()">Подтвердить анкету</button><p class="sub" style="margin-top:12px">Правки можно внести здесь — потом AI подберёт совпадения.</p>`)}
function saveP(){Object.assign(S.u,{job:$('#e1').value,int:$('#e2').value,food:$('#e3').value,bio:$('#e4').value,world:$('#e10').value,zodiac:$('#e5').value,height:$('#e6').value,edu:$('#e7').value,alco:$('#e8').value,smoke:$('#e9').value});go({scr:'match'});setTimeout(()=>go({scr:'app',tab:'home'}),1800)}
