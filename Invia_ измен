<button class="btn main go" onclick="invite(${p.id})"><span>Пригласить на свидание</span></button>`}
function invite(id){if(!S.prem&&S.sent>=3)return paywall('Лимит: 3 приглашения в неделю. С подпиской — без ограничений.');S.inv={p:id,pl:null,d:null,t:null,cond:null,tx:'',st:'tender'};go({scr:'inv',tab:'home',open:null,vp:null})}
/* ---------- invitation ---------- */
function inv(){const v=S.inv;return shell(`<h1>Приглашение</h1><div class="card" style="border-radius:44px;padding:20px"><div style="display:flex;justify-content:center;margin-bottom:8px">${av(v.p,76)}</div>
<div class="rowf" onclick="pickPlace()"><b>Место свидания:</b><span class="${v.pl?'ok':''}">${v.pl?plc(v.pl).n:'выбрать →'}</span></div>
<div class="rowf" onclick="tg('date')"><b>Дата и время:</b><span class="${v.d?'ok':''}">${v.d?v.d+' сентября, '+v.t:'выбрать'}</span></div>
${S.open=='date'?`${calHTML(v.d)}<div class="times">${T.map(t=>`<button class="${v.t==t?'sel':''}" onclick="S.inv.t='${t}';keep()">${t}</button>`).join('')}</div>`:''}
