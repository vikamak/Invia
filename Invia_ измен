<div class="chips" style="margin:8px 0 0">${ST.map(([k,l])=>`<button class="chip ${v.st==k?'on':''}" onclick="S.inv.tx=$('#lt').value;S.inv.st='${k}';keep()">${l}</button>`).join('')}</div>
<div class="letter s-${v.st}">${deco(v.st)}<textarea id="lt" maxlength="99" placeholder="Введите текст…" oninput="S.inv.tx=this.value;$('#cn').textContent=this.value.length+'/99'">${esc(v.tx)}</textarea><small id="cn">${v.tx.length}/99</small></div>
