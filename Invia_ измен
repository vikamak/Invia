<div class="card"><div class="ir">${ic('pin',20)}${x.ad}</div><div class="ir">${ic('clock',20)}Время работы: ${x.h}</div><div class="ir">${ic('globe',20)}<u>Веб-сайт</u></div><div class="ir">${ic('phone',20)}${x.ph}</div></div>
<div class="card"><div style="font-size:20px;margin-bottom:10px">Отзывы</div>${x.rv.map(r=>`<div style="display:flex;gap:12px;margin-bottom:10px">${av(1+(x.id%4),46)}<div><div style="color:var(--gold)">★★★★☆</div><div style="font-size:13.5px;line-height:1.4">${r}</div></div></div>`).join('')}</div>
${S.pick?`<button class="btn main" onclick="choose(${x.id})">Выбрать это место</button>`:`<button class="btn" onclick="toast('Выбери человека на главной и нажми «Пригласить»')">Как пригласить сюда?</button>`}`}
function choose(id){S.inv.pl=id;go({scr:'inv',tab:'home',pick:false,pd:null,open:null})}
/* ---------- planner ---------- */
function plan(){return `<h1>Планнер</h1><p class="sub">Все твои свидания — в одном месте.</p>
<div class="card" style="border-radius:24px;padding:16px"><div style="display:flex;justify-content:space-between;font-size:22px;font-weight:600"><span>2026</span><span>SEPTEMBER</span></div>${calGrid(S.sd,'pickDay','plCal')}</div>
<div id="dayInfo" style="min-height:120px">${dayInfoHTML(S.sd)}</div>
${S.inc.length?`<div style="margin:16px 4px 10px">Входящие приглашения</div>`+S.inc.map((c,i)=>`<div class="card" style="border-radius:28px"><div style="display:flex;gap:12px;align-items:center">${av(c.p,58)}<div><b style="font-weight:500;font-size:18px">${pp(c.p).n}</b><div class="mute" style="font-size:13px">${plc(c.pl).n} · ${c.d} сентября, ${c.t}</div></div></div><div class="letter sm s-${c.st}">${deco(c.st)}${esc(c.tx)}</div><div class="mute" style="font-size:12.5px">${c.cond}</div><div style="display:flex;gap:10px;margin-top:12px"><button class="btn sm main" style="flex:1" onclick="accept(${i})">Принять</button><button class="btn sm" style="flex:1" onclick="S.inc.splice(${i},1);render()">Отклонить</button></div><div style="margin-top:10px;text-align:center"><button class="chip" onclick="toggleResched(${i})">${S.resched===i?'Свернуть':'Предложить перенести время'}</button></div>${S.resched===i?`<div style="margin-top:12px">${calGrid(S.rd,'setReschedDate','rsCal')}<div class="times">${T.map(t=>`<button class="${S.rt==t?'sel':''}" onclick="setRT(this,'${t}')">${t}</button>`).join('')}</div><button class="btn sm main" style="margin-top:10px" onclick="sendResched()">Отправить предложение</button></div>`:''}</div>`).join(''):''}
<div style="margin:18px 4px 10px">Все свидания</div>${S.ev.slice().sort((a,b)=>a.d-b.d).map(evc).join('')}`}
function evc(e){const idx=S.ev.indexOf(e);return `<div class="card" style="display:flex;align-items:center;gap:14px;border-radius:60px;padding:10px 24px 10px 10px">${av(e.p,72)}<div style="text-align:center;flex:1"><div style="font-size:14px">${e.d} сентября ${e.t}</div><div style="font-size:13px" class="mute">${esc(e.pl)}</div><div style="font-size:22px">${pp(e.p).n}</div>${e.st=='wait'?`<button class="chip" style="padding:5px 12px;font-size:12px" onclick="S.ev[${idx}].st='ok';render();toast('${pp(e.p).n} принял(а) приглашение')">Думает… · демо: принять</button>`:'<div style="color:var(--gold);font-size:12px">✓ подтверждено</div>'}</div></div>`}
function accept(i){const c=S.inc.splice(i,1)[0];S.ev.push({d:c.d,t:c.t,pl:plc(c.pl).n,p:c.p,st:'ok'});S.sd=c.d;render();toast('Свидание добавлено в планнер ✓')}
/* ---------- profile ---------- */
function prof(){const u=S.u,f=[['job','Профессия'],['int','Интересы'],['food','Еда'],['bio','О себе'],['world','Мировоззрение'],['zodiac','Знак зодиака'],['height','Рост, см'],['edu','Образование'],['alco','Алкоголь'],['smoke','Курение']];
return `<div style="margin:-22px -16px 16px;padding:26px 20px 20px;background:linear-gradient(160deg,#680209,#0a0304);border-radius:0 0 40px 40px"><div style="display:flex;justify-content:space-between"><button class="chip" onclick="S.edit=!S.edit;render()">${ic('edit',16)} ${S.edit?'Готово':'Править'}</button><button class="chip" onclick="paywall()">${ic('gear',16)} ${S.prem?'Premium':'Подписка'}</button></div>
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:24px"><div><div style="font-size:26px;letter-spacing:.04em">${esc(u.n)}, ${u.a}</div><div class="mute">${esc(u.job)}</div></div><div onclick="storyAct()" style="cursor:pointer" title="Выложить историю">${av('me',96,'ring')}</div></div>
