function vprof(p){const rows=[['Интересы',p.int],['Еда',p.food],['Мировоззрение',p.world],['Знак зодиака',p.zod],['Рост',p.hgt+' см'],['Образование',p.edu],['Алкоголь',p.alco],['Курение',p.smoke],['О себе',p.bio],['Вас объединяет',p.c]];
