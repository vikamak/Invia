function modal(h){const d=document.createElement('div');d.className='modal';d.onclick=e=>{if(e.target===d)d.remove()};d.innerHTML=`<div>${h}</div>`;$('#app').append(d);return d}
function storyAct(){
if(!S.prem){const d=modal(`<div class="script" style="font-size:32px;text-align:center">Выложить историю</div><p class="sub" style="margin-top:8px">Премиум-функция.<br>История видна 24 часа.</p><button class="btn main go" id="sSub"><span>Оформить подписку</span></button>`);$('#sSub').onclick=()=>{d.remove();paywall('Истории на 24 часа доступны по подписке')};return}
if(S.story){const d=modal(`<div class="script" style="font-size:32px;text-align:center">Твоя история</div><p class="sub" style="margin-top:8px">«${esc(S.story)}» · исчезнет через 24 часа</p><button class="btn" id="sDel">Удалить историю</button>`);$('#sDel').onclick=()=>{S.story=null;d.remove()};return}
const d=modal(`<div class="script" style="font-size:32px;text-align:center">Выложить историю</div><p class="sub" style="margin-top:6px">Премиум-функция · видна 24 часа</p><input class="in" id="sIn" placeholder="Например: Сегодня творческий вайб" style="margin-top:8px"><button class="btn main go" id="sPub"><span>Опубликовать</span></button>`);$('#sPub').onclick=()=>{S.story=$('#sIn').value.trim()||'Сегодня отличное настроение';d.remove();toast('История опубликована на 24 часа')}}
function paywall(m){const d=modal(`<div class="script" style="font-size:36px;text-align:center">Invia Premium</div><p class="sub" style="margin-top:8px">${m||'Больше романтики — меньше ограничений.'}</p><div style="line-height:2;font-size:15px;margin-bottom:16px">✓ Реклама отключена<br>✓ Приглашения без лимита (сейчас 3 в неделю)<br>✓ Больше фото в профиле<br>✓ Истории на 24 часа</div><button class="btn main go" id="sb">Оформить подписку (демо)</button>`);$('#sb').onclick=()=>{S.prem=true;d.remove();render();toast('Premium включён')}}
function delAcc(){const d=modal(`<div class="script" style="font-size:32px;text-align:center">Удалить профиль?</div><p class="sub" style="margin-top:8px">Анкета, приглашения и свидания будут удалены. Это действие нельзя отменить.</p><button class="btn danger" id="dY">Да, удалить</button><button class="btn" id="dN" style="margin-top:10px">Отмена</button>`);$('#dN').onclick=()=>d.remove();$('#dY').onclick=()=>{Object.keys(S).forEach(k=>delete S[k]);Object.assign(S,fresh());render()}}
/* ---------- router ---------- */
function render(){const st=$('#mn')?$('#mn').scrollTop:0,sc=S.scr;let h;
if(sc=='reg')h=reg();else if(sc=='chat')return draw();else if(sc=='confirm')h=confirmP();else if(sc=='match')h=match();else if(sc=='inv')h=inv();
else{const b={home,place,plan,prof}[S.tab]();h=shell(b,S.tab=='home'&&!S.vp?'snap':'')}
$('#app').innerHTML=h;document.querySelectorAll('.btn:not(.sm):not(.danger)').forEach(b=>{if(!b.firstElementChild)b.classList.add('go')});const m=$('#mn');if(m&&sc!='match'&&sc!='confirm')m.scrollTop=(S.vp&&sc=='app'&&S.tab=='home'&&!S._vp)?0:st;document.querySelectorAll('.wh').forEach(w=>w.scrollTop=w.dataset.i*40)}
render();
</script></body></html>
