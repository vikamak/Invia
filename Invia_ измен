<div style="display:flex;align-items:center;gap:14px">${av(p.id,64)}<div><div style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:600;line-height:1.1;display:flex;align-items:center;gap:8px">${p.n}, ${p.a} ${vf(24)}</div><div style="color:var(--gold);font-size:14px;margin-top:2px">${p.j}</div></div></div>
