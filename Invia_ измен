/* ---------- places ---------- */
function place(){if(S.pd)return pdetail(plc(S.pd));return `<h1>Место свидания</h1><p class="sub">Мы подобрали для вас атмосферные места рядом, чтобы познакомиться в реальной жизни.</p>
<div class="chips">${['Рестораны','Бары','Творчество','Активность'].map(c=>`<button class="chip ${S.cat==c?'on':''}" onclick="S.cat='${c}';render()">${c}</button>`).join('')}</div>
${PL.filter(x=>x.cat==S.cat).map(x=>`<div class="place" onclick="go({pd:${x.id}})"><div class="ph" style="background:linear-gradient(150deg,${x.g.split(',')[0]},${x.g.split(',')[1]})">${ic({Рестораны:'fork',Бары:'glass',Творчество:'brush',Активность:'bolt'}[x.cat],44)}</div><div><div class="script">${x.n}</div><div style="font-size:13.5px;margin:4px 0">${x.d}</div><div style="color:var(--gold);font-size:14px">${x.r} ★</div>${x.t.map(t=>`<span class="tag">${t}</span>`).join('')}</div></div>`).join('')}`}
