<div class="photo ph" style="background:${grad(p.g,k)}" onclick="nextPh(${p.id})"><span style="opacity:.14">${ic('user',150)}</span><div style="position:absolute;left:14px;top:14px">${av(p.id,50)}</div><div class="dots">${[0,1,2,3].map(j=>`<u class="${j==k?'on':''}"></u>`).join('')}</div>
