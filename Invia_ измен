function deco(st){if(st=='tender')return `<div class="deco"><svg width="30" height="26" viewBox="0 0 24 24" fill="#f3a8c4" stroke="#c9527f" stroke-width="1"><path d="M12 20s-8-5-8-11a4.500 4.500 0 018-2.800A4.500 4.500 0 0120 9c0 6-8 11-8 11z"/></svg></div>`;
if(st=='lux')return `<div class="deco"><svg width="120" height="20" viewBox="0 0 120 20" fill="none" stroke="#d8b06a" stroke-width="1.200"><path d="M4 10h44M72 10h44"/><path d="M60 2l7 8-7 8-7-8z" fill="#d8b06a"/></svg></div>`;
return `<div class="deco"><svg width="60" height="12" viewBox="0 0 60 12" stroke="#222"><path d="M0 6h24M36 6h24"/><circle cx="30" cy="6" r="2.500" fill="#222"/></svg></div>`}
function av(p,s=64,x=''){const u=p==='me'?S.u:pp(p);const bg=p==='me'&&S.u.ph?`url(${S.u.ph}) center/cover`:grad(p==='me'?0:u.g);return `<div class="av ${x}" style="width:${s}px;height:${s}px;background:${bg};font-size:${s/2}px">${p==='me'&&S.u.ph?'':(p==='me'?(S.u.n[0]||''):u.n[0])}</div>`}
function toast(m){const t=document.createElement('div');t.className='toast';t.textContent=m;$('#app').append(t);setTimeout(()=>t.remove(),2600)}
function go(o){Object.assign(S,o);render()}
function tab(t){go({scr:'app',tab:t,pd:null,pick:false,vp:null})}
function shell(body,cls=''){return `<main class="${cls}" id="mn">${body}</main>`+(S.scr==='app'||S.scr==='inv'?`<nav>${[['home','home','Главная'],['place','pin','Место свидания'],['plan','cal','Планнер'],['prof','user','Профиль']].map(([k,i,l])=>`<button class="${S.tab==k?'on':''}" onclick="tab('${k}')">${ic(i,26)}${l}</button>`).join('')}</nav>`:'')}
/* carousel dots (no re-render → no jitter) */
function cs(el){const i=Math.round(el.scrollLeft/el.clientWidth);el.parentNode.querySelectorAll('.cdots u').forEach((u,j)=>u.classList.toggle('on',j==i))}
function carousel(items){return `<div class="cw"><div class="car" onscroll="cs(this)">${items}</div><div class="cdots">${items.match(/<div /g).map((_,j)=>`<u class="${j?'':'on'}"></u>`).join('')}</div></div>`}
/* ---------- registration ---------- */
const MO=['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const rng=(a,b)=>Array.from({length:b-a+1},(_,i)=>a+i);
function wheel(k,labels,vals,cur){return `<div class="wh" data-i="${vals.indexOf(cur)}" onscroll="wsc(this,'${k}')">${vals.map((v,i)=>`<div data-v="${v}">${labels[i]}</div>`).join('')}</div>`}
function wsc(w,k){clearTimeout(w.t);w.t=setTimeout(()=>{const i=Math.max(0,Math.min(w.children.length-1,Math.round(w.scrollTop/40)));S.u.bd[k]=+w.children[i].dataset.v},80)}
function seg(k,a){return `<div class="seg" data-k="${k}">${a.map(([v,l])=>`<button data-v="${v}" class="${S.u[k]==v?'on':''}" onclick="setU('${k}','${v}')">${l}</button>`).join('')}</div>`}
function setU(k,v){S.u[k]=v;const box=document.querySelector(`.seg[data-k="${k}"]`);if(box)box.querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.v===v))}
function age(){const b=S.u.bd,d=Math.min(b.d,new Date(b.y,b.m,0).getDate()),t=new Date();let a=t.getFullYear()-b.y;if(t.getMonth()+1<b.m||(t.getMonth()+1==b.m&&t.getDate()<d))a--;return a}
function reg(){const u=S.u;return shell(`<div style="text-align:center;margin:8px 0 6px"><img src="${ICON}" alt="Иконка Invia" style="height:118px;display:block;margin:0 auto 6px"><div class="script" style="font-size:44px;line-height:1">Invia</div></div><p class="sub">Знакомства без переписки.<br>Меньше сообщений — больше живых встреч.</p>
<div class="card" style="text-align:center"><label for="pf" style="cursor:pointer;display:grid;justify-items:center;gap:8px;margin-bottom:18px">${u.ph?av('me',112):`<div class="av" style="width:112px;height:112px;border:1.5px dashed var(--mute);color:var(--mute);background:#120908">${ic('camera',36)}</div>`}<span class="mute" style="font-size:13px">Добавить фото</span></label>
<input id="pf" type="file" accept="image/*" hidden onchange="photo(this)">
<input class="in" id="rn" placeholder="Имя" value="${esc(u.n)}">
<div class="lb">Дата рождения</div><div class="wheels">${wheel('d',rng(1,31),rng(1,31),u.bd.d)}${wheel('m',MO,rng(1,12),u.bd.m)}${wheel('y',rng(1950,2008),rng(1950,2008),u.bd.y)}</div>
<div class="lb">Пол</div>${seg('sex',[['m','Мужской'],['f','Женский']])}
<div class="lb">Кого ищу</div>${seg('look',[['f','Женщин'],['m','Мужчин']])}
<button class="btn main" onclick="startChat()">Продолжить</button></div>`)}
function photo(i){const f=i.files[0];if(!f)return;const r=new FileReader();r.onload=e=>{S.u.n=$('#rn').value;S.u.ph=e.target.result;render()};r.readAsDataURL(f)}
function startChat(){const n=$('#rn').value.trim(),a=age();S.u.n=n;if(!n)return toast('Введи имя, чтобы продолжить');if(a<18)return toast('Приложение доступно с 18 лет');if(!S.u.sex)return toast('Выбери свой пол');if(!S.u.look)return toast('Выбери, кого ищешь');S.u.a=a;
S.inc=[{...INC[S.u.sex]}];/* мужчине — письмо от Дарьи, женщине — от Игоря */
S.chat=[];S.step='intro';S.scr='chat';render();askStep()}
function skipChat(){Object.assign(S.u,{job:'',int:'',food:'',weekend:'',values:'',world:'',zodiac:'',height:'',edu:'',alco:'',smoke:'',bio:''});go({scr:'confirm',skipped:1})}
/* ---- AI-interview engine ---- */
const JOBS=['строитель','дизайнер','программист','разработчик','менеджер','маркетолог','врач','инженер','психолог','фотограф','архитектор','стилист','модель','юрист','учитель','преподаватель','предприниматель','музыкант','актёр','актер','повар','пилот','военный','тренер','бариста','флорист','визажист','бухгалтер','аналитик','копирайтер'];
const HOB=[['пе(ть|ни)','пение'],['чита','чтение'],['бег','бег'],['гольф','гольф'],['рисова','рисование'],['путешеств','путешествия'],['готов','готовку'],['танц','танцы'],['фотограф','фотографию'],['\\bкино','кино'],['музык','музыку'],['йог','йогу'],['серф','сёрфинг'],['плава','плавание'],['шахмат','шахматы'],['\\bспорт','спорт'],['вело','велоспорт'],['театр','театр'],['рыбал','рыбалку'],['книг','книги']];
const MSG={weekend:'Как выглядит твой идеальный выходной?',values:'Что ты ценишь в людях?',world:'А какое у тебя мировоззрение или взгляд на жизнь?',zodiac:'Забавный вопрос: ты веришь в знаки зодиака?',zpick:'Здорово! Какой у тебя знак — учту звёзды при подборе пар.',height:'Какой у тебя рост, в сантиметрах?',edu:'Какое у тебя образование?',alco:'Как ты относишься к алкоголю?',smoke:'А как насчёт курения?',done:'Отлично, ты супер человек! Вот твоя анкета:'};
const EDU=['Среднее','Среднее специальное','Высшее','Учусь в вузе'],ALCO=['Не пью','Иногда','По особым случаям','Часто'],SMOKE=['Не курю','Иногда','Курю'],ZODIAC=['Овен','Телец','Близнецы','Рак','Лев','Дева','Весы','Скорпион','Стрелец','Козерог','Водолей','Рыбы'];
const NEXT={weekend:'values',values:'world',world:'zodiac',zpick:'height',height:'edu',edu:'alco',alco:'smoke',smoke:'done'};
function cap(s){return s?s.charAt(0).toUpperCase()+s.slice(1):s}
function parseIntro(v){const t=v.toLowerCase();let job='';for(const j of JOBS)if(t.includes(j)){job=cap(j);break}const found=[];for(const[re,label]of HOB){if(new RegExp(re,'i').test(t)&&!found.includes(label))found.push(label)}S.u.job=job;S.u.int=found.length?cap(found.join(', ')):''}
function summaryText(){return `Кажется, я тебя понял! Вот что получилось:\nПрофессия: ${S.u.job||'пока не указана'}\nУвлечения: ${S.u.int||'пока не указаны'}`}
function chat(){const s=S.step;return `<div style="display:flex;flex-direction:column;height:100%"><h1>AI-анкета</h1><p class="sub">${s=='intro'?'Расскажи о себе своими словами — я сам разложу это по пунктам.':'Отвечай коротко. Неудобный вопрос можно пропустить.'}</p><div style="text-align:center;margin:-8px 0 12px"><button class="chip" onclick="skipChat()">Пропустить и заполнить самому</button></div><div id="msgs" style="flex:1;overflow-y:auto">${S.chat.map(m=>`<div class="msg ${m.w}">${esc(m.t)}</div>`).join('')}</div>${ctrl()}</div>`}
function ctrl(){const s=S.step;
if(s=='zodiac')return `<div style="display:flex;gap:10px;padding-top:8px"><button class="btn sm main" style="flex:1" onclick="answerYesNo('да')">Да</button><button class="btn sm" style="flex:1" onclick="answerYesNo('нет')">Нет</button></div>${skipRow()}`;
if(s=='zpick')return `<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding-top:8px">${ZODIAC.map(z=>`<button class="chip" style="justify-content:center" onclick="answerZodiac('${z}')">${z}</button>`).join('')}</div>${skipRow()}`;
if(s=='edu')return btnGrid(EDU,'edu');if(s=='alco')return btnGrid(ALCO,'alco');if(s=='smoke')return btnGrid(SMOKE,'smoke');
if(s=='done')return '';
return `<div style="display:flex;gap:8px;padding-top:8px"><input class="in" id="ci" style="margin:0" ${s=='height'?'type="number"':''} placeholder="${s=='intro'?'Например: Антон 23 года, я строитель, люблю петь, читать, бегать...':'Твой ответ…'}" onkeydown="if(event.key==='Enter')sendText()"><button class="btn sm main" onclick="sendText()">➤</button></div>${s=='intro'?'':skipRow()}`}
function btnGrid(opts,key){return `<div style="display:flex;flex-wrap:wrap;gap:8px;padding-top:8px">${opts.map(o=>`<button class="chip" onclick="answerButtons('${key}','${o}')">${o}</button>`).join('')}</div>${skipRow()}`}
function skipRow(){return `<div style="text-align:center;margin-top:8px"><button class="chip" onclick="skipStep()">Пропустить вопрос</button></div>`}
function askStep(){S.chat.push({w:'ai',t:MSG[S.step]||'Расскажи о себе, а я помогу тебе составить профиль.'});draw();if(S.step=='done')setTimeout(finishChat,900)}
function draw(){$('#app').innerHTML=shell(chat());const m=$('#msgs');m.scrollTop=m.scrollHeight;const ci=$('#ci');if(ci)ci.focus()}
function sendText(){const v=$('#ci').value.trim();if(!v)return toast('Напиши ответ или нажми «Пропустить вопрос»');S.chat.push({w:'me',t:v});draw();
if(S.step=='intro'){setTimeout(()=>{parseIntro(v);S.chat.push({w:'ai',t:summaryText()});draw();S.step='weekend';setTimeout(askStep,750)},550);return}
S.u[S.step]=v;S.step=NEXT[S.step];setTimeout(askStep,550)}
function answerYesNo(v){S.chat.push({w:'me',t:v==='да'?'Да':'Нет'});draw();
if(v==='да'){S.step='zpick';setTimeout(askStep,550)}
else{setTimeout(()=>{S.u.zodiac='';S.chat.push({w:'ai',t:'Я тоже больше верю в химию между людьми, чем в ретроградный Меркурий.'});draw();S.step='height';setTimeout(askStep,750)},550)}}
function answerZodiac(z){S.u.zodiac=z;S.chat.push({w:'me',t:z});draw();S.step='height';setTimeout(askStep,550)}
function answerButtons(key,val){S.u[key]=val;S.chat.push({w:'me',t:val});draw();S.step=NEXT[key];setTimeout(askStep,550)}
function skipStep(){S.chat.push({w:'me',t:'Пропускаю этот вопрос'});draw();S.step=S.step=='zodiac'?'height':NEXT[S.step];setTimeout(askStep,550)}
function finishChat(){const u=S.u,parts=[];if(u.job)parts.push(u.job);if(u.int)parts.push('увлекается: '+u.int.toLowerCase());if(u.weekend)parts.push('идеальный выходной — '+u.weekend.toLowerCase());if(u.values)parts.push('ценит в людях '+u.values.toLowerCase());if(u.world)parts.push(u.world.toLowerCase());u.bio=parts.length?cap(parts.join('. '))+'.':'';go({scr:'confirm',skipped:0})}
function confirmP(){const u=S.u,l=(t)=>`<label class="mute" style="font-size:13px">${t}</label>`;return shell(`<h1>Твоя анкета</h1><p class="sub">${S.skipped?'Заполни анкету сам — позже её можно изменить в профиле.':'AI собрал её из твоих ответов. Всё верно?'}</p><div class="card"><div style="display:flex;gap:14px;align-items:center;margin-bottom:12px">${av('me',70)}<div style="font-size:20px">${esc(u.n)}, ${u.a}</div></div>
